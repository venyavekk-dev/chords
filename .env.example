# Lemon Squeezy hosted checkout URL for the "Купить за 20€" lifetime unlock.
# Create a store + product in Lemon Squeezy, then paste its checkout URL here
# (e.g. https://YOURSTORE.lemonsqueezy.com/checkout/buy/VARIANT_ID).
# Leave empty to keep the button disabled (no provider set up yet).
VITE_LEMONSQUEEZY_CHECKOUT_URL=

# Shared unlock code for the paywall's "Код доступа" field. Anyone who enters
# this exact code gets permanent access on that browser (same effect as
# purchasing). Share it with yourself and with people who paid manually via
# card/SBP after you've confirmed the transfer. Leave empty to disable the
# field (no code will ever match).
VITE_UNLOCK_CODE=
